# Engine base URL (falls back to the production Railway URL if unset)
VITE_API_URL=

# AEO Citation Layer — Stripe Payment Links.
# NOTHING IS SET UP IN STRIPE YET. There is no product, no price, and no
# payment link. These are placeholders, not URLs, so they cannot be mistaken
# for working links or accidentally shipped as if they resolved to something.
# When the citation layer is actually revisited: create the real Stripe
# products then, and set the real values directly in Vercel's environment
# variables — never back into this file.
VITE_CITATION_LINK_ONETIME=PLACEHOLDER_SET_IN_VERCEL_WHEN_LIVE
VITE_CITATION_LINK_SUBSCRIPTION=PLACEHOLDER_SET_IN_VERCEL_WHEN_LIVE

# ── Vercel serverless function: api/send-report.js (server side, process.env) ──
RESEND_API_KEY=
RESEND_REPORTS_FROM="Canopy Guard <reports@thecanopyguard.com>"
RESEND_FOLLOWUP_FROM="Adam McClarin <adam@thecanopyguard.com>"
RESEND_REPLY_TO=adam@thecanopyguard.com
CALENDLY_URL=https://calendly.com/hello-merakislove/new-meeting
SITE_URL=https://thecanopyguard.com
